{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axme.dev/schemas/public_api/api.sessions.create.response.v1.json",
  "title": "ApiSessionsCreateResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "session_id",
    "status",
    "created_at"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "WAITING_OWNER",
        "RESOLVED",
        "CLOSED",
        "PRUNED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
